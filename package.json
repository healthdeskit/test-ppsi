{
  "name": "ppsi-web",
  "version": "1.0.0",
  "private": true,
  "description": "PPSI website – run server for full site, forms, and admin",
  "scripts": {
    "install:server": "cd server && npm install",
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "convert:webp": "node scripts/convert-to-webp.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f web",
    "docker:php": "docker compose --profile php-local up -d --build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
