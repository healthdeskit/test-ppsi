.git
.gitignore
.env
.env.*
!.env.example

node_modules
server/node_modules

# Runtime data (use volume)
data/*.json
data/uploads/*
!data/.gitkeep

# Dev / docs
*.md
.vscode
.idea
*.log
.DS_Store
Thumbs.db

# Not needed inside Node image
php
admin/*.php
_templates
scripts

# Optional: keep compose file out of image context bloat (already excluded by COPY scope; harmless)
docker-compose*.yml
